---
import { Image } from "astro:assets";
const {
  title,
  img,
  img2,
  desc,
  url,
  badge,
  tags,
  techStack,
  target = "_blank",
  extraDetails,
  extraImages,
  extraVideo,
} = Astro.props;

const hasExtras =
  Boolean(extraDetails) ||
  Boolean(extraImages && extraImages.length > 0) ||
  Boolean(extraVideo);
---
<div class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]">
  <a href={url} target={target}>
    <div class="hero-content flex-col md:flex-row">
      {(img || img2) && (
        <div class="flex flex-col md:items-start gap-3">
          {img && (
            <Image
              width={750}
              height={422}
              format="webp"
              src={img}
              alt={title}
              class="max-w-full md:max-w-[16rem] rounded-lg"
            />
          )}
          {img2 && (
            <Image
              width={750}
              height={422}
              format="webp"
              src={img2}
              alt={`${title} - second image`}
              class="max-w-full md:max-w-[16rem] rounded-lg"
            />
          )}
        </div>
      )}
      <div class="grow w-full p-5 md:p-0">
        <h1 class="text-xl font-bold">
          {title}
          {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
        </h1>
        <p class="py-1 text-1xl">{desc}</p>
        {techStack && (
          <p class="py-1 text-sm text-base-content/70">
            <span class="font-semibold">Tech Stack:</span> {techStack}
          </p>
        )}
        {tags && tags.length > 0 && (
          <div class="mt-2 flex flex-wrap gap-1">
            {tags.map((tag) => (
              <a href={`/blog/tag/${tag}`} class="badge badge-outline">{tag}</a>
            ))}
          </div>
        )}
      </div>
    </div>
  </a>

  {hasExtras && (
    <details class="collapse collapse-arrow bg-base-200 rounded-lg mx-5 md:mx-0 mb-5 md:mb-0">
      <summary class="collapse-title text-sm font-semibold">
        More details
      </summary>
      <div class="collapse-content">
        {extraDetails && <p class="text-sm py-1 whitespace-pre-line">{extraDetails}</p>}
        {extraImages && extraImages.length > 0 && (
          <div class="flex flex-wrap gap-3 mt-2">
            {extraImages.map((image) => (
              <Image
                width={400}
                height={300}
                format="webp"
                src={image}
                alt={`${title} - additional photo`}
                class="w-48 h-36 sm:w-56 sm:h-40 object-contain bg-base-100 rounded-lg"
              />
            ))}
          </div>
        )}
        {extraVideo && (
          <div class="mt-3">
            <video controls preload="metadata" class="w-full max-w-xs rounded-lg">
              <source src={extraVideo} />
              Your browser does not support the video tag.
            </video>
          </div>
        )}
      </div>
    </details>
  )}
</div>